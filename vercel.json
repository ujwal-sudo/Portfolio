{
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/about",
      "dest": "/about.html"
    },
    {
      "src": "/projects",
      "dest": "/projects/index.html"
    },
    {
      "src": "/projects/pythia-160m",
      "dest": "/projects/pythia-160m/index.html"
    },
    {
      "src": "/projects/codesensei",
      "dest": "/projects/codesensei/index.html"
    },
    {
      "src": "/projects/ledgerlens",
      "dest": "/projects/ledgerlens/index.html"
    },
    {
      "src": "/projects/talktoweb",
      "dest": "/projects/talktoweb/index.html"
    },
    {
      "src": "/research",
      "dest": "/research.html"
    },
    {
      "src": "/interests",
      "dest": "/interests.html"
    },
    {
      "src": "/resume",
      "dest": "/resume.html"
    },
    {
      "src": "/contact",
      "dest": "/contact.html"
    },
    {
      "src": "/lore",
      "dest": "/lore.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
